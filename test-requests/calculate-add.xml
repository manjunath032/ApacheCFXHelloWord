<!-- Test Case 1: Calculate ADD operation -->
<!-- Expected: result = 25.0, operation = ADD (normalized to uppercase) -->
<!-- Expected ResponseDetails: timestamp, serverId, processingTime populated -->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" 
               xmlns:cal="http://example.com/calculator">
   <soap:Header/>
   <soap:Body>
      <cal:calculate>
         <cal:operand1>15</cal:operand1>
         <cal:operand2>10</cal:operand2>
         <cal:operation>ADD</cal:operation>
      </cal:calculate>
   </soap:Body>
</soap:Envelope>
