<!-- Test Case 8: Calculate with negative numbers -->
<!-- Expected: result = -35.0, operation = ADD -->
<!-- Expected ResponseDetails: timestamp, serverId, processingTime populated -->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" 
               xmlns:cal="http://example.com/calculator">
   <soap:Header/>
   <soap:Body>
      <cal:calculate>
         <cal:operand1>-50</cal:operand1>
         <cal:operand2>15</cal:operand2>
         <cal:operation>ADD</cal:operation>
      </cal:calculate>
   </soap:Body>
</soap:Envelope>
