<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://example.com/calculator"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://example.com/calculator"
             name="CalculatorService">

    <types>
        <xsd:schema targetNamespace="http://example.com/calculator"
                    elementFormDefault="qualified">
            
            <!-- SOAP Header Types -->
            <xsd:complexType name="ResponseDetails">
                <xsd:annotation>
                    <xsd:documentation>Response header details sent in SOAP output header</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="timestamp" type="xsd:dateTime">
                        <xsd:annotation>
                            <xsd:documentation>Response timestamp</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="serverId" type="xsd:string">
                        <xsd:annotation>
                            <xsd:documentation>Server instance ID that processed the request</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="processingTime" type="xsd:long">
                        <xsd:annotation>
                            <xsd:documentation>Processing time in milliseconds</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:element name="responseDetails" type="tns:ResponseDetails"/>
            
            <!-- Fault Types -->
            <xsd:complexType name="ServiceFailoverFault">
                <xsd:annotation>
                    <xsd:documentation>Fault thrown when service failover occurs</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="faultCode" type="xsd:string">
                        <xsd:annotation>
                            <xsd:documentation>Error code (e.g., SERVICE_UNAVAILABLE, FAILOVER_IN_PROGRESS)</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="faultMessage" type="xsd:string">
                        <xsd:annotation>
                            <xsd:documentation>Human-readable error message</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="failoverNode" type="xsd:string" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>Suggested failover node to retry</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="retryAfter" type="xsd:int" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>Suggested retry delay in seconds</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:element name="serviceFailoverFault" type="tns:ServiceFailoverFault"/>
            
            <!-- Complex Types for Request/Response Holders -->
            
            <!-- Add Operation Types -->
            <xsd:complexType name="AddRequest">
                <xsd:annotation>
                    <xsd:documentation>Request holder for addition operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="a" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>First operand</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="b" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Second operand</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="AddResponse">
                <xsd:annotation>
                    <xsd:documentation>Response holder for addition operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="result" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Sum of operands</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <!-- Subtract Operation Types -->
            <xsd:complexType name="SubtractRequest">
                <xsd:annotation>
                    <xsd:documentation>Request holder for subtraction operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="a" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Minuend</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="b" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Subtrahend</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="SubtractResponse">
                <xsd:annotation>
                    <xsd:documentation>Response holder for subtraction operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="result" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Difference of operands</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <!-- Multiply Operation Types -->
            <xsd:complexType name="MultiplyRequest">
                <xsd:annotation>
                    <xsd:documentation>Request holder for multiplication operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="a" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>First factor</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="b" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Second factor</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="MultiplyResponse">
                <xsd:annotation>
                    <xsd:documentation>Response holder for multiplication operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="result" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Product of operands</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <!-- Divide Operation Types -->
            <xsd:complexType name="DivideRequest">
                <xsd:annotation>
                    <xsd:documentation>Request holder for division operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="a" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Dividend</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="b" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Divisor (must not be zero)</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="DivideResponse">
                <xsd:annotation>
                    <xsd:documentation>Response holder for division operation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="result" type="xsd:double">
                        <xsd:annotation>
                            <xsd:documentation>Quotient of operands</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <!-- Calculate Operation Types - Advanced Example with Multiple Fields -->
            <xsd:complexType name="CalculateRequest">
                <xsd:annotation>
                    <xsd:documentation>Advanced request holder with multiple fields for batch calculation</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="operand1" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>First operand</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="operand2" type="xsd:int">
                        <xsd:annotation>
                            <xsd:documentation>Second operand</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="operation" type="xsd:string">
                        <xsd:annotation>
                            <xsd:documentation>Operation to perform: ADD, SUBTRACT, MULTIPLY, DIVIDE</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="CalculateResponse">
                <xsd:annotation>
                    <xsd:documentation>Advanced response holder with multiple fields</xsd:documentation>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="result" type="xsd:double">
                        <xsd:annotation>
                            <xsd:documentation>Calculation result</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="operation" type="xsd:string">
                        <xsd:annotation>
                            <xsd:documentation>Operation performed</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="responseDetails" type="tns:ResponseDetails">
                        <xsd:annotation>
                            <xsd:documentation>Response details including timestamp, server ID, and processing time</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            
            <!-- Element Wrappers for all operations -->
            <xsd:element name="add" type="tns:AddRequest"/>
            <xsd:element name="addResponse" type="tns:AddResponse"/>
            
            <xsd:element name="subtract" type="tns:SubtractRequest"/>
            <xsd:element name="subtractResponse" type="tns:SubtractResponse"/>
            
            <xsd:element name="multiply" type="tns:MultiplyRequest"/>
            <xsd:element name="multiplyResponse" type="tns:MultiplyResponse"/>
            
            <xsd:element name="divide" type="tns:DivideRequest"/>
            <xsd:element name="divideResponse" type="tns:DivideResponse"/>
            
            <xsd:element name="calculate" type="tns:CalculateRequest"/>
            <xsd:element name="calculateResponse" type="tns:CalculateResponse"/>
            
        </xsd:schema>
    </types>

    <!-- Messages using the new element wrappers -->
    <message name="addRequest">
        <part name="parameters" element="tns:add"/>
    </message>
    <message name="addResponse">
        <part name="parameters" element="tns:addResponse"/>
    </message>
    
    <message name="subtractRequest">
        <part name="parameters" element="tns:subtract"/>
    </message>
    <message name="subtractResponse">
        <part name="parameters" element="tns:subtractResponse"/>
    </message>
    
    <message name="multiplyRequest">
        <part name="parameters" element="tns:multiply"/>
    </message>
    <message name="multiplyResponse">
        <part name="parameters" element="tns:multiplyResponse"/>
    </message>
    
    <message name="divideRequest">
        <part name="parameters" element="tns:divide"/>
    </message>
    <message name="divideResponse">
        <part name="parameters" element="tns:divideResponse"/>
    </message>
    
    <message name="calculateRequest">
        <part name="parameters" element="tns:calculate"/>
    </message>
    <message name="calculateResponse">
        <part name="parameters" element="tns:calculateResponse"/>
    </message>
    
    <!-- Header Messages -->
    <message name="responseDetailsHeader">
        <part name="responseDetails" element="tns:responseDetails"/>
    </message>
    
    <!-- Fault Messages -->
    <message name="serviceFailoverFault">
        <part name="fault" element="tns:serviceFailoverFault"/>
    </message>

    <!-- Port Type -->
    <portType name="CalculatorPortType">
        <operation name="add">
            <documentation>Add two integers</documentation>
            <input message="tns:addRequest"/>
            <output message="tns:addResponse"/>
            <fault name="serviceFailoverFault" message="tns:serviceFailoverFault"/>
        </operation>
        <operation name="subtract">
            <documentation>Subtract two integers</documentation>
            <input message="tns:subtractRequest"/>
            <output message="tns:subtractResponse"/>
            <fault name="serviceFailoverFault" message="tns:serviceFailoverFault"/>
        </operation>
        <operation name="multiply">
            <documentation>Multiply two integers</documentation>
            <input message="tns:multiplyRequest"/>
            <output message="tns:multiplyResponse"/>
            <fault name="serviceFailoverFault" message="tns:serviceFailoverFault"/>
        </operation>
        <operation name="divide">
            <documentation>Divide two integers</documentation>
            <input message="tns:divideRequest"/>
            <output message="tns:divideResponse"/>
            <fault name="serviceFailoverFault" message="tns:serviceFailoverFault"/>
        </operation>
        <operation name="calculate">
            <documentation>Advanced operation to perform dynamic calculation based on operation type</documentation>
            <input message="tns:calculateRequest"/>
            <output message="tns:calculateResponse"/>
            <fault name="serviceFailoverFault" message="tns:serviceFailoverFault"/>
        </operation>
    </portType>

    <!-- Binding -->
    <binding name="CalculatorBinding" type="tns:CalculatorPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        
        <operation name="add">
            <soap:operation soapAction="add"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:responseDetailsHeader" part="responseDetails" use="literal"/>
            </output>
            <fault name="serviceFailoverFault">
                <soap:fault name="serviceFailoverFault" use="literal"/>
            </fault>
        </operation>
        
        <operation name="subtract">
            <soap:operation soapAction="subtract"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:responseDetailsHeader" part="responseDetails" use="literal"/>
            </output>
            <fault name="serviceFailoverFault">
                <soap:fault name="serviceFailoverFault" use="literal"/>
            </fault>
        </operation>
        
        <operation name="multiply">
            <soap:operation soapAction="multiply"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:responseDetailsHeader" part="responseDetails" use="literal"/>
            </output>
            <fault name="serviceFailoverFault">
                <soap:fault name="serviceFailoverFault" use="literal"/>
            </fault>
        </operation>
        
        <operation name="divide">
            <soap:operation soapAction="divide"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:responseDetailsHeader" part="responseDetails" use="literal"/>
            </output>
            <fault name="serviceFailoverFault">
                <soap:fault name="serviceFailoverFault" use="literal"/>
            </fault>
        </operation>
        
        <operation name="calculate">
            <soap:operation soapAction="calculate"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:responseDetailsHeader" part="responseDetails" use="literal"/>
            </output>
            <fault name="serviceFailoverFault">
                <soap:fault name="serviceFailoverFault" use="literal"/>
            </fault>
        </operation>
    </binding>

    <!-- Service -->
    <service name="CalculatorService">
        <documentation>Calculator Web Service with holder pattern for request/response objects</documentation>
        <port name="CalculatorPort" binding="tns:CalculatorBinding">
            <soap:address location="http://localhost:8080/services/Calculator"/>
        </port>
    </service>
</definitions>
