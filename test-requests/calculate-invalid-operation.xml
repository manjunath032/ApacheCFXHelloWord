<!-- Test Case 7: Calculate with invalid operation (Error Case) -->
<!-- Expected: SOAP Fault with message "Unknown operation: POWER. Supported operations: ADD, SUBTRACT, MULTIPLY, DIVIDE" -->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" 
               xmlns:cal="http://example.com/calculator">
   <soap:Header/>
   <soap:Body>
      <cal:calculate>
         <cal:operand1>2</cal:operand1>
         <cal:operand2>8</cal:operand2>
         <cal:operation>POWER</cal:operation>
      </cal:calculate>
   </soap:Body>
</soap:Envelope>
