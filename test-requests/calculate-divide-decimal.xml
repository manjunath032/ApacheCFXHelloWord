<!-- Test Case 5: Calculate DIVIDE with decimal result -->
<!-- Expected: result = 3.3333... (decimal division) -->
<!-- Expected ResponseDetails: timestamp, serverId, processingTime populated -->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" 
               xmlns:cal="http://example.com/calculator">
   <soap:Header/>
   <soap:Body>
      <cal:calculate>
         <cal:operand1>10</cal:operand1>
         <cal:operand2>3</cal:operand2>
         <cal:operation>DIVIDE</cal:operation>
      </cal:calculate>
   </soap:Body>
</soap:Envelope>
